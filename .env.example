# Copy to ".env" (next to package.json) to change server behaviour. Everything is optional.

# Ports. HTTP works everywhere on the LAN; HTTPS is needed for streaming downloads straight to disk.
PORT=3000
HTTPS_PORT=3443
# Set to 0 to disable the HTTPS listener.
HTTPS=1
# Interface to bind. 0.0.0.0 = every network interface (needed so other devices can connect).
HOST=0.0.0.0

# Use your own trusted certificate (for example created with mkcert) instead of the generated self-signed one.
# TLS_CERT=./certs/lanshare.pem
# TLS_KEY=./certs/lanshare-key.pem

# Force a password on every room created on this server (people still choose their own display name).
# ROOM_PASSWORD=change-me
# Require the room admin (first person in) to approve each newcomer.
REQUIRE_APPROVAL=0

# Abuse limits
MAX_PEERS_PER_ROOM=50
MAX_ROOMS=100
JOINS_PER_MINUTE=30
